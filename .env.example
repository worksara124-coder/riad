# Point d'intégration des demandes de réservation (côté serveur uniquement).
# Laissez vide pour rester en mode démonstration : aucune donnée n'est transmise.
# Exemple : URL d'un webhook (Make, Zapier, n8n, votre propre API…) qui recevra un JSON.
RESERVATION_WEBHOOK_URL=

# Facultatif : secret envoyé dans l'en-tête "X-Riad-Noor-Secret" pour authentifier l'appel.
RESERVATION_WEBHOOK_SECRET=
